---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const flavors = [
	{
		id: 'original',
		name: 'Original Savory',
		tagline: 'Klasik Gurih Renyah',
		desc: 'Irisan pisang kepok matang sempurna, digoreng garing dengan taburan garam laut gurih dan aroma khas alami.',
		price: 'Rp 15.000',
		badge: 'Best Seller',
		badgeColor: 'bg-amber-500/20 text-amber-600 dark:text-amber-400 border-amber-500/30',
		themeColor: '#eab308',
		gradient: 'from-amber-400 to-yellow-500',
		image: '/images/original.png'
	},
	{
		id: 'balado',
		name: 'Balado Pedas Manis',
		tagline: 'Sensasi Cabe Asli',
		desc: 'Kombinasi cabai merah segar pilihan dengan gula aren caramel. Pedas nendang, manis legit bikin ga mau berhenti.',
		price: 'Rp 17.000',
		badge: 'Favorit Juara',
		badgeColor: 'bg-red-500/20 text-red-600 dark:text-red-400 border-red-500/30',
		themeColor: '#ef4444',
		gradient: 'from-red-500 to-orange-500',
		image: '/images/balado.png'
	},
	{
		id: 'cokelat',
		name: 'Double Dark Chocolate',
		tagline: 'Lumer Manis Nagih',
		desc: 'Balutan cokelat pekat premium tebal yang melimpah, tidak bikin eneg dan pas banget buat nemenin santai sore.',
		price: 'Rp 17.000',
		badge: 'Kids Favorite',
		badgeColor: 'bg-purple-500/20 text-purple-600 dark:text-purple-400 border-purple-500/30',
		themeColor: '#8b5cf6',
		gradient: 'from-amber-800 to-purple-800',
		image: '/images/cokelat.png'
	},
	{
		id: 'keju',
		name: 'Creamy Cheese Crunch',
		tagline: 'Gurih Manis Mewah',
		desc: 'Taburan keju cheddar spesial bertekstur lembut dengan cita rasa creamy gurih yang meleleh di lidah.',
		price: 'Rp 17.000',
		badge: 'Super Creamy',
		badgeColor: 'bg-orange-500/20 text-orange-600 dark:text-orange-400 border-orange-500/30',
		themeColor: '#f97316',
		gradient: 'from-amber-500 to-orange-400',
		image: '/images/keju.png'
	}
];

const highlights = [
	{ title: '100% Pisang Pilihan', desc: 'Dipanen langsung dari kebun lokal petani Nusantara' },
	{ title: 'Tanpa Pengawet', desc: 'Diproses higienis tahan renyah alami hingga 3 bulan' },
	{ title: 'Ekstra Renyah', desc: 'Irisan tipis pas digoreng dengan suhu minyak stabil' },
	{ title: 'Bumbu Melimpah', desc: 'Tiap keping keripik terbalut bumbu merata penuh rasa' }
];

const testimonials = [
	{
		quote: '“Rasa originalnya bener-bener beda! Gak berminyak dan renyahnya tahan lama walau bungkus udah dibuka seharian. Selalu nyetok di rumah!”',
		name: 'Ayu Rahmania',
		role: 'Ibu Rumah Tangga & Food Blogger',
		rating: 5,
	},
	{
		quote: '“Varian Balado-nya nendang parah! Pedas manisnya pas banget, gak bikin sakit tenggorokan. Cocok buat temen nonton atau kerja.”',
		name: 'Dimas Pratama',
		role: 'Software Engineer, Jakarta',
		rating: 5,
	},
	{
		quote: '“Anak-anak suka banget varian Cokelat & Keju. Kemasannya rapi, modern dan estetik. Pengirimannya juga cepat dan aman banget.”',
		name: 'Nabila Putri S.',
		role: 'Pelanggan Setia, Surabaya',
		rating: 5,
	}
];
---

<Layout>
	<div class="relative min-h-screen overflow-x-hidden pb-20 md:pb-0 selection:bg-amber-400 selection:text-amber-950">
		
		<!-- ================= HEADER / NAVBAR ================= -->
		<header id="navbar" class="fixed inset-x-0 top-0 z-50 px-3 pt-3 transition-all duration-300 sm:px-5 sm:pt-4">
			<nav class="mx-auto flex max-w-7xl items-center justify-between rounded-2xl border border-stone-200/80 bg-[#fffdf7]/90 px-3 py-2.5 shadow-[0_12px_40px_rgba(41,37,36,.10)] backdrop-blur-2xl transition-all duration-300 sm:px-4 dark:border-white/10 dark:bg-[#111216]/90 dark:shadow-[0_12px_40px_rgba(0,0,0,.28)]">
				
				<!-- Logo -->
				<a href="#" class="group flex items-center gap-2.5 sm:gap-3" aria-label="Beranda 4 Jagoan">
					<img
						src="/images/logo-4-jagoan.png"
						alt="Logo Keripik Pisang 4 Jagoan"
						class="h-11 w-11 rounded-xl object-contain transition-transform duration-300 group-hover:-rotate-3 group-hover:scale-105 sm:h-12 sm:w-12"
					/>
					<div>
						<span class="font-display text-base sm:text-lg font-black tracking-tight text-stone-900 transition-colors dark:text-white">4 JAGOAN</span>
						<span class="block text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Keripik Pisang Premium</span>
					</div>
				</a>

				<!-- Desktop Nav Links -->
				<div class="hidden items-center gap-8 text-sm font-semibold text-stone-700 dark:text-stone-300 md:flex">
					<a class="nav-link py-1 hover:text-amber-600 dark:hover:text-amber-400 transition" href="#beranda">Beranda</a>
					<a class="nav-link py-1 hover:text-amber-600 dark:hover:text-amber-400 transition" href="#keunggulan">Keunggulan</a>
					<a class="nav-link py-1 hover:text-amber-600 dark:hover:text-amber-400 transition" href="#produk">Varian Rasa</a>
					<a class="nav-link py-1 hover:text-amber-600 dark:hover:text-amber-400 transition" href="#tentang">Tentang</a>
					<a class="nav-link py-1 hover:text-amber-600 dark:hover:text-amber-400 transition" href="#ulasan">Ulasan</a>
				</div>

				<!-- Right Action Buttons: Theme Toggle & Order CTA -->
				<div class="flex items-center gap-2 sm:gap-3">
					
					<!-- Light / Dark Theme Toggle Button -->
					<button
						id="theme-toggle"
						type="button"
						class="relative flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full border border-stone-200 bg-stone-100/90 text-stone-700 transition-all hover:bg-stone-200/80 active:scale-90 dark:border-stone-800 dark:bg-stone-800/80 dark:text-amber-400 dark:hover:bg-stone-700"
						aria-label="Ganti mode tema (Terang / Gelap)"
						title="Ganti Mode Tampilan"
					>
						<!-- Sun Icon (visible in dark mode) -->
						<svg id="theme-toggle-light-icon" class="hidden h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
						</svg>
						<!-- Moon Icon (visible in light mode) -->
						<svg id="theme-toggle-dark-icon" class="hidden h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 20 20">
							<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
						</svg>
					</button>

					<!-- Order Button (Desktop) -->
					<a
						href="https://wa.me/6281234567890?text=Halo%20Keripik%20Pisang%204%20Jagoan,%20saya%20mau%20pesan"
						target="_blank"
						rel="noopener noreferrer"
						class="hidden sm:inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-amber-500 to-yellow-400 px-4 py-2 sm:px-5 sm:py-2.5 text-xs font-black uppercase tracking-wider text-stone-900 shadow-md shadow-amber-500/20 transition-all hover:shadow-lg hover:shadow-amber-500/35 hover:-translate-y-0.5"
					>
						<span>Pesan Sekarang</span>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>

					<!-- Mobile Menu Hamburger -->
					<button
						id="menu-button"
						class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-xl border border-stone-200 bg-stone-100 text-stone-800 transition dark:border-stone-800 dark:bg-stone-800 dark:text-stone-200 md:hidden"
						aria-label="Buka navigasi mobile"
						aria-expanded="false"
					>
						<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
					</button>
				</div>
			</nav>

			<!-- Mobile Menu Dropdown -->
			<div id="mobile-menu" class="mx-3 mb-3 hidden overflow-hidden rounded-2xl border border-stone-200/80 bg-white/98 p-3 shadow-2xl backdrop-blur-2xl transition dark:border-white/10 dark:bg-stone-900/98 md:hidden">
				<div class="flex flex-col gap-1.5">
					<a class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold text-stone-800 hover:bg-amber-50 dark:text-stone-200 dark:hover:bg-stone-800/80" href="#beranda">
						<span>Beranda</span>
						<span class="text-xs text-stone-400">→</span>
					</a>
					<a class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold text-stone-800 hover:bg-amber-50 dark:text-stone-200 dark:hover:bg-stone-800/80" href="#keunggulan">
						<span>Keunggulan</span>
						<span class="text-xs text-stone-400">→</span>
					</a>
					<a class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold text-stone-800 hover:bg-amber-50 dark:text-stone-200 dark:hover:bg-stone-800/80" href="#produk">
						<span>Varian Rasa</span>
						<span class="text-xs text-stone-400">→</span>
					</a>
					<a class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold text-stone-800 hover:bg-amber-50 dark:text-stone-200 dark:hover:bg-stone-800/80" href="#tentang">
						<span>Tentang Kami</span>
						<span class="text-xs text-stone-400">→</span>
					</a>
					<a class="mobile-nav-link flex items-center justify-between rounded-xl px-4 py-3 text-sm font-bold text-stone-800 hover:bg-amber-50 dark:text-stone-200 dark:hover:bg-stone-800/80" href="#ulasan">
						<span>Ulasan Pembeli</span>
						<span class="text-xs text-stone-400">→</span>
					</a>
				</div>
			</div>
		</header>

		<main>
			<!-- ================= 1. HERO SECTION ================= -->
			<section id="beranda" class="relative overflow-hidden bg-gradient-to-b from-amber-50/70 via-stone-50 to-white pt-24 pb-12 sm:pt-36 lg:pb-28 dark:from-[#14141a] dark:via-[#0e0f14] dark:to-[#0c0d12]">
				
				<!-- Ambient Glow Orbs -->
				<div class="hero-glow-1 pointer-events-none absolute -top-24 left-1/2 h-[340px] w-[340px] -translate-x-1/2 rounded-full sm:h-[650px] sm:w-[650px]"></div>
				<div class="hero-glow-2 pointer-events-none absolute top-48 -right-20 h-[300px] w-[300px] rounded-full"></div>
				
				<!-- Subtle Tech Grid Pattern -->
				<div class="pointer-events-none absolute inset-0 opacity-[0.035] dark:opacity-[0.06] [background-image:radial-gradient(#d97706_1px,transparent_1px)] [background-size:24px_24px]"></div>

				<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-8">
						
						<!-- Hero Text Column -->
						<div class="relative z-10 text-center lg:text-left lg:col-span-7">
							<!-- Pill Tag -->
							<div class="reveal inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3.5 py-1.5 text-[11px] sm:text-xs font-extrabold uppercase tracking-widest text-amber-600 dark:text-amber-400 backdrop-blur-md">
								<span class="relative flex h-2 w-2">
									<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
									<span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"></span>
								</span>
								Premium Artisanal Snack UMKM
							</div>

							<!-- Headline Mobile-Optimized -->
							<h1 class="reveal mt-4 sm:mt-6 font-display text-[2.4rem] leading-[1.05] font-black tracking-tight text-stone-900 sm:text-6xl sm:leading-[1.08] lg:text-[4.5rem] dark:text-white" style="transition-delay: 80ms;">
								Sensasi Renyahnya <br />
								Bikin <span class="bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 bg-clip-text text-transparent underline decoration-amber-400/30 underline-offset-4 sm:underline-offset-8">Gagal Berhenti.</span>
							</h1>

							<!-- Clean Hero Image for Mobile (Displayed right after headline on mobile for immediate visual impact) -->
							<div class="reveal my-6 flex items-center justify-center lg:hidden" style="transition-delay: 140ms;">
								<div class="relative flex w-full max-w-[320px] items-center justify-center">
									<div class="pointer-events-none absolute h-52 w-52 rounded-full bg-amber-400/20 blur-2xl dark:bg-amber-400/10"></div>
									<div class="pointer-events-none absolute -inset-3 rounded-full border border-amber-400/25 dark:border-amber-400/10"></div>
									<img
										src="/images/hero-4-jagoan.png"
										alt="Keripik Pisang 4 Jagoan Promotion"
										class="hero-image h-auto w-full object-contain drop-shadow-2xl max-h-[300px]"
										loading="eager"
									/>
								</div>
							</div>

							<!-- Subtitle -->
							<p class="reveal mx-auto lg:mx-0 max-w-xl text-sm sm:text-lg leading-relaxed text-stone-600 dark:text-stone-300" style="transition-delay: 160ms;">
								Dibuat dari 100% pisang pilihan dengan racikan bumbu khas 4 Jagoan. Irisan tipis, garing gurih tanpa minyak berlebih!
							</p>

							<!-- CTA Buttons -->
							<div class="reveal mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4" style="transition-delay: 240ms;">
								<a
									href="#produk"
									class="group flex items-center justify-center gap-3 rounded-full bg-stone-950 py-3.5 px-7 text-sm font-bold text-white shadow-xl shadow-stone-950/20 transition-all hover:bg-stone-800 active:scale-95 dark:bg-amber-400 dark:text-stone-950 dark:hover:bg-amber-300 dark:shadow-amber-400/20"
								>
									<span>Jelajahi Varian Rasa</span>
									<span class="flex h-6 w-6 items-center justify-center rounded-full bg-white/20 transition-transform group-hover:translate-x-1 dark:bg-stone-950/20 text-xs">
										→
									</span>
								</a>

								<a
									href="https://wa.me/6281234567890?text=Halo%20Keripik%20Pisang%204%20Jagoan,%20saya%20mau%20order"
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center justify-center gap-2.5 rounded-full border border-stone-300/80 bg-white/80 py-3.5 px-6 text-sm font-bold text-stone-800 shadow-sm transition-all hover:border-amber-400 hover:bg-amber-50/50 hover:text-amber-600 active:scale-95 dark:border-stone-800 dark:bg-stone-900/80 dark:text-stone-200"
								>
									<span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
									<span>Chat WhatsApp Admin</span>
								</a>
							</div>

							<!-- Micro Stats / Highlights Grid -->
							<div class="reveal mt-8 sm:mt-10 grid grid-cols-3 gap-2 rounded-2xl border border-stone-200/80 bg-white/60 p-3 sm:p-5 dark:border-white/10 dark:bg-white/[0.03] backdrop-blur-md" style="transition-delay: 300ms;">
								<div>
									<div class="font-display text-xl sm:text-3xl font-black text-amber-600 dark:text-amber-400">15K+</div>
									<div class="text-[10px] sm:text-xs font-semibold text-stone-500 dark:text-stone-400">Terjual</div>
								</div>
								<div class="border-x border-stone-200/70 dark:border-white/10">
									<div class="font-display text-xl sm:text-3xl font-black text-amber-600 dark:text-amber-400">4.9</div>
									<div class="text-[10px] sm:text-xs font-semibold text-stone-500 dark:text-stone-400">Rating</div>
								</div>
								<div>
									<div class="font-display text-xl sm:text-3xl font-black text-amber-600 dark:text-amber-400">100%</div>
									<div class="text-[10px] sm:text-xs font-semibold text-stone-500 dark:text-stone-400">Alami</div>
								</div>
							</div>
						</div>

						<!-- Desktop Hero Image Column -->
						<div class="reveal relative hidden lg:flex items-center justify-center lg:col-span-5" style="transition-delay: 200ms;">
							<div class="pointer-events-none absolute h-72 w-72 rounded-full bg-amber-400/25 blur-3xl dark:bg-amber-400/15 sm:h-96 sm:w-96"></div>
							<div class="pointer-events-none absolute -inset-6 rounded-full border border-amber-400/25 dark:border-amber-400/10"></div>
							<div class="pointer-events-none absolute -inset-14 rounded-full border border-dashed border-amber-400/20 dark:border-stone-700/40"></div>

							<div class="relative z-10 w-full max-w-[480px]">
								<img
									src="/images/hero-4-jagoan.png"
									alt="Keripik Pisang 4 Jagoan Promotion"
									class="hero-image h-auto w-full object-contain drop-shadow-2xl"
									loading="eager"
								/>
							</div>
						</div>

					</div>
				</div>

				<!-- ================= WAVE ANIMATION 1 (Hero to Keunggulan) ================= -->
				<div class="relative -mb-1 mt-10 sm:mt-16 w-full overflow-hidden leading-none pointer-events-none">
					<!-- Wave Layer 1 (Back wave, warm amber tint, slow) -->
					<div class="flex w-[200%] animate-wave-slow opacity-60 text-amber-200/50 dark:text-amber-500/10">
						<svg class="h-20 w-1/2 sm:h-32" viewBox="0 0 1440 180" preserveAspectRatio="none">
							<path d="M0,60 C320,160 560,-20 900,80 C1140,150 1320,30 1440,70 L1440,180 L0,180 Z" fill="currentColor"></path>
						</svg>
						<svg class="h-20 w-1/2 sm:h-32" viewBox="0 0 1440 180" preserveAspectRatio="none">
							<path d="M0,60 C320,160 560,-20 900,80 C1140,150 1320,30 1440,70 L1440,180 L0,180 Z" fill="currentColor"></path>
						</svg>
					</div>
					<!-- Wave Layer 2 (Middle wave, medium speed) -->
					<div class="absolute inset-x-0 bottom-0 flex w-[200%] animate-wave-medium opacity-75 text-stone-200 dark:text-[#181924]">
						<svg class="h-16 w-1/2 sm:h-28" viewBox="0 0 1440 180" preserveAspectRatio="none">
							<path d="M0,90 C280,10 520,160 840,40 C1100,-40 1300,120 1440,60 L1440,180 L0,180 Z" fill="currentColor"></path>
						</svg>
						<svg class="h-16 w-1/2 sm:h-28" viewBox="0 0 1440 180" preserveAspectRatio="none">
							<path d="M0,90 C280,10 520,160 840,40 C1100,-40 1300,120 1440,60 L1440,180 L0,180 Z" fill="currentColor"></path>
						</svg>
					</div>
					<!-- Wave Layer 3 (Front solid wave matching next section) -->
					<div class="absolute inset-x-0 bottom-0 flex w-[200%] animate-wave-fast text-stone-100 dark:text-[#121318]">
						<svg class="h-14 w-1/2 sm:h-24" viewBox="0 0 1440 180" preserveAspectRatio="none">
							<path d="M0,40 C360,140 700,0 1020,90 C1220,140 1360,60 1440,50 L1440,180 L0,180 Z" fill="currentColor"></path>
						</svg>
						<svg class="h-14 w-1/2 sm:h-24" viewBox="0 0 1440 180" preserveAspectRatio="none">
							<path d="M0,40 C360,140 700,0 1020,90 C1220,140 1360,60 1440,50 L1440,180 L0,180 Z" fill="currentColor"></path>
						</svg>
					</div>
				</div>
			</section>


			<!-- ================= 2. KEUNGGULAN SECTION ================= -->
			<section id="keunggulan" class="relative bg-stone-100 py-16 dark:bg-[#121318] sm:py-28">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="reveal mx-auto max-w-2xl text-center">
						<span class="inline-block rounded-full bg-amber-500/10 px-3.5 py-1 text-xs font-black uppercase tracking-widest text-amber-600 dark:text-amber-400">
							Kualitas Tanpa Kompromi
						</span>
						<h2 class="mt-3 font-display text-2xl font-black tracking-tight text-stone-900 dark:text-white sm:text-5xl">
							Kenapa Harus <span class="bg-gradient-to-r from-amber-500 to-yellow-500 bg-clip-text text-transparent">4 Jagoan?</span>
						</h2>
						<p class="mt-2 text-xs sm:text-base text-stone-600 dark:text-stone-400">
							Bukan sekadar keripik pisang biasa, kami meramu setiap batch dengan standar resep terbaik untuk kenikmatan maksimal.
						</p>
					</div>

					<div class="mt-10 sm:mt-14 grid grid-cols-2 gap-3.5 sm:gap-6 lg:grid-cols-4">
						{highlights.map((item, idx) => (
							<div
								class="reveal card-hover-effect relative overflow-hidden rounded-2xl sm:rounded-3xl border border-stone-200/80 bg-white p-4 sm:p-7 dark:border-white/5 dark:bg-[#181920]"
								style={`transition-delay: ${idx * 80}ms;`}
							>
								<div class="h-1.5 w-10 rounded-full bg-gradient-to-r from-amber-500 to-yellow-400"></div>
								<h3 class="mt-3.5 sm:mt-6 font-display text-sm sm:text-lg font-bold text-stone-900 dark:text-white">
									{item.title}
								</h3>
								<p class="mt-1 sm:mt-2 text-[11px] sm:text-sm leading-relaxed text-stone-600 dark:text-stone-400">
									{item.desc}
								</p>
